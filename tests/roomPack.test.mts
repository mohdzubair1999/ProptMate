ok("room names are tidied (spaces) and summaries trimmed; over-long text is cut to 3,000 characters and 200", (() => { const r = PS([{ room: "  Master   bedroom ", summary: "  ok  " }, { room: "x".repeat(500), summary: "y".repeat(9000) }]); return r[0].room === "Master bedroom" && r[0].summary === "ok" && r[1].room.length === 200 && r[1].summary.length === 3000; })());
ok("at most 60 rooms are read", PS(Array.from({ length: 100 }, (_, i) => ({ room: `R${i}`, summary: "s" }))).length === 60);
ok("'below good' means wear and tear or worse (not new, good, unknown or empty)", BG("wear_and_tear") && BG("worn") && BG("damaged") && BG("beyond_economical_repair") && !BG("good") && !BG("new") && !BG("weird") && !BG(null) && !BG(undefined));
// ---------- building the room pack ----------
const sums = JSON.stringify([{ room: "Kitchen", summary: "Clean. Oven working." }, { room: "lounge", summary: "Marks on the wall by the door." }, { room: "Garage", summary: "Not used." }]);
let m = B(sums, { items: [it("Kitchen", "Oven", "damaged"), it("Kitchen", "Hob", "good"), it("Lounge", "Sofa", "worn"), it("Bedroom", "Bed", "good")] });
ok("each room carries its own summary, matched ignoring capitals and spacing", m.rooms.find((r) => r.room === "Kitchen")!.summary === "Clean. Oven working." && m.rooms.find((r) => r.room === "Lounge")!.summary === "Marks on the wall by the door.", m.rooms.map((r) => [r.room, r.summary]));
ok("a room with no summary in their report says null (the PDF says so in words)", m.rooms.find((r) => r.room === "Bedroom")!.summary === null);
ok("rooms the report describes that have no items at check-out are listed separately, not lost", m.unmatchedSummaries.length === 1 && m.unmatchedSummaries[0].room === "Garage" && m.unmatchedSummaries[0].summary === "Not used.", m.unmatchedSummaries);
ok("rooms keep the order they were recorded in; within a room the more serious conditions come first", m.rooms.map((r) => r.room).join() === "Kitchen,Lounge,Bedroom" && m.rooms[0].items.map((i) => i.itemName).join() === "Oven,Hob", m.rooms.map((r) => r.room));
ok("counts: 3 rooms, 4 items, 2 rooms with a summary, 2 items below good", JSON.stringify(m.counts) === '{"rooms":3,"items":4,"roomsWithSummary":2,"itemsBelowGood":2}', m.counts);
m = B(JSON.stringify([{ room: "Kitchen", summary: "First part." }, { room: "KITCHEN", summary: "Second part." }]), { items: [it("Kitchen", "Oven")] }); ok("two summaries for the same room are kept together, in order, not dropped", m.rooms[0].summary === "First part.\n\nSecond part.", m.rooms[0].summary);
m = B("garbage", { items: [it("Kitchen", "Oven", "damaged")] }); ok("with no usable summaries every room says so and nothing breaks", m.rooms.length === 1 && m.rooms[0].summary === null && m.unmatchedSummaries.length === 0);
m = B(sums, { items: [] }); ok("a check-out with no items gives no rooms, and every summary shows as unmatched (so it is clear nothing could be set against them)", m.rooms.length === 0 && m.unmatchedSummaries.length === 3 && m.counts.items === 0);
m = B(sums, null); ok("a missing check-out is treated as empty", m.rooms.length === 0);
m = B(sums, { items: [it("", "Mystery"), it(" ", "Other")] }); ok("items with no room are grouped under 'Room not recorded', not lost", m.rooms.length === 1 && m.rooms[0].room === "Room not recorded" && m.rooms[0].items.length === 2, m.rooms.map((r) => r.room));
let thr = 0; for (const junk of [null, undefined, 5, "x", {}, { items: null }, { items: [null] }, { items: [5] }, { items: [{}] }] as any[]) { try { B(sums, junk); B(junk, junk); } catch { thr++; } } ok("junk input never throws", thr === 0, thr);
let seed = 8; const rnd = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296; const pick = <T,>(a: T[]) => a[Math.floor(rnd() * a.length)]; let bad = 0;
for (let t = 0; t < 3000; t++) { const rooms = ["Kitchen", "kitchen ", "Lounge", "Bed 1", "Garage", ""]; const items = Array.from({ length: Math.floor(rnd() * 14) }, () => it(pick(rooms), pick(["Oven", "Sofa", "Bed"]), pick(["new", "good", "worn", "damaged", "x", ""]))); const s = Array.from({ length: Math.floor(rnd() * 6) }, () => ({ room: pick(rooms), summary: pick(["a", "b", ""]) }));
  const r = B(JSON.stringify(s), { items }); const sumItems = r.rooms.reduce((a, x) => a + x.items.length, 0); if (sumItems !== items.length || r.counts.items !== items.length) bad++;
  const names = new Set(r.rooms.map((x) => x.room.trim().toLowerCase())); if (names.size !== r.rooms.length) bad++;
  const goodS = PS(s); for (const g of goodS) { const k = g.room.trim().toLowerCase(); const inRooms = r.rooms.some((x) => x.room.trim().toLowerCase() === k && x.summary && x.summary.includes(g.summary)); const inUn = r.unmatchedSummaries.some((x) => x.room.trim().toLowerCase() === k && x.summary.includes(g.summary)); if (!inRooms && !inUn) bad++; if (inRooms && inUn) bad++; }
  if (r.counts.itemsBelowGood !== items.filter((i) => ["wear_and_tear", "worn", "damaged", "beyond_economical_repair"].includes(i.condition)).length) bad++; }
ok("3,000 random room packs: every item appears exactly once, no room is listed twice, every summary appears exactly once (matched to a room or listed as unmatched, never both, never lost), and the below-good count is exact", bad === 0, bad);
// ---------- side by side or stacked ----------
const room = (summary: string | null, items: PackItem[]) => ({ room: "R", summary, items });
ok("a short summary and a couple of items: side by side", RL(room("Clean. Oven working.", [it("R", "Oven", "good"), it("R", "Hob", "good")])) === "side");
ok("a 3,000-character summary: stacked (a column that tall cannot be split across pages)", RL(room("x".repeat(3000), [it("R", "Oven")])) === "stack");
ok("a 600-character summary is side by side; a 2,500-character one (taller than a page in a narrow column) is stacked", RL(room("x".repeat(600), [it("R", "Oven")])) === "side" && RL(room("x".repeat(2500), [it("R", "Oven")])) === "stack");
ok("a room with 15 ordinary items: stacked", RL(room("ok", Array.from({ length: 15 }, (_, i) => it("R", `I${i}`)))) === "stack");
ok("a room with 5 items in good condition: side by side", RL(room("ok", Array.from({ length: 5 }, (_, i) => it("R", `I${i}`)))) === "side");
ok("long notes on an item push the room to stacked", RL(room("ok", [it("R", "Oven", "good", { notes: "n".repeat(2500) })])) === "stack");
ok("photos and a recorded assessment on damaged items make them taller (so fewer fit side by side)", EH(room("ok", [it("R", "Oven", "damaged", { photos: [{ url: "a" }, { url: "b" }], disputeRiskClassification: "tenant_responsibility", disputeRiskReasoning: "r".repeat(200) })])).items > EH(room("ok", [it("R", "Oven", "good")])).items + 100);
