import { buildRoomPack as B, parseRoomSummaries as PS, isBelowGood as BG, roomLayout as RL, estimateRoomHeights as EH, type PackItem } from "../lib/disputePack";
let pass = 0, fail = 0; const ok = (n: string, c: boolean, x: any = "") => { c ? pass++ : (fail++, console.log("FAIL:", n, typeof x === "string" ? x.slice(0, 300) : JSON.stringify(x).slice(0, 400))); };
let n = 0; const it = (room: string, itemName: string, condition = "good", o: Partial<PackItem> = {}): PackItem => ({ id: `i${++n}`, room, itemName, condition, cleanliness: "clean", make: null, quantity: null, notes: null, photos: [], disputeRiskClassification: null, disputeRiskReasoning: null, disputeRiskConfidence: null, disputeRiskEvidenceNote: null, ...o });
// ---------- reading the stored summaries ----------
ok("the stored JSON text is read into rooms and summaries", JSON.stringify(PS('[{"room":"Kitchen","summary":"Clean, oven working"},{"room":"Lounge","summary":"Marks on wall"}]')) === '[{"room":"Kitchen","summary":"Clean, oven working"},{"room":"Lounge","summary":"Marks on wall"}]');
ok("an array that is already parsed works too", PS([{ room: "A", summary: "x" }]).length === 1);
