import { objectLayer, OBJECT_LAYERS, SYMBOLS, SYMBOL_KINDS, type PlanObject } from "../lib/floorPlanObjects";
let pass = 0, fail = 0; const ok = (n: string, c: boolean, x: any = "") => { c ? pass++ : (fail++, console.log("FAIL:", n, typeof x === "string" ? x.slice(0, 300) : JSON.stringify(x).slice(0, 400))); };
const sym = (symbol: string): PlanObject => ({ id: "s", kind: "symbol", symbol: symbol as any, x: 1, y: 1, w: 1, l: 1, rot: 0 });
ok("there are five layers a person can hide, each with a plain name: Furniture, Safety and services, Labels, Defect pins, Free-standing walls", OBJECT_LAYERS.map((l) => l.label).join("|") === "Furniture|Safety and services|Labels|Defect pins|Free-standing walls" && new Set(OBJECT_LAYERS.map((l) => l.id)).size === 5);
ok("every safety and services symbol is on the 'services' layer, and every other symbol (all 35 furniture and fittings) is on 'furniture'", SYMBOL_KINDS.every((k) => objectLayer(sym(k)) === (SYMBOLS[k].group === "Safety and services" ? "services" : "furniture")) && SYMBOL_KINDS.filter((k) => objectLayer(sym(k)) === "services").length === 10 && SYMBOL_KINDS.filter((k) => objectLayer(sym(k)) === "furniture").length === 35);
ok("a label is on 'labels' and a label with a pin number is on 'pins'; a free-standing wall is on 'walls'", objectLayer({ id: "l", kind: "label", x: 1, y: 1, text: "Hall", size: 12, rot: 0 }) === "labels" && objectLayer({ id: "p", kind: "label", x: 1, y: 1, text: "Damp", size: 12, rot: 0, pin: 3 }) === "pins" && objectLayer({ id: "w", kind: "wall", x1: 0, y1: 0, x2: 2, y2: 0, t: 0.1 }) === "walls");
ok("every possible object lands on one of the five layers (none is left that can never be hidden)", [...SYMBOL_KINDS.map(sym), { id: "l", kind: "label", x: 1, y: 1, text: "a", size: 12, rot: 0 } as PlanObject, { id: "p", kind: "label", x: 1, y: 1, text: "a", size: 12, rot: 0, pin: 1 } as PlanObject, { id: "w", kind: "wall", x1: 0, y1: 0, x2: 2, y2: 0, t: 0.1 } as PlanObject].every((o) => OBJECT_LAYERS.some((l) => l.id === objectLayer(o))));
ok("a damaged saved symbol name does not crash the layer lookup (it is treated as furniture)", (() => { try { return objectLayer({ id: "x", kind: "symbol", symbol: "nonsense", x: 1, y: 1, w: 1, l: 1, rot: 0 } as any) === "furniture"; } catch { return false; } })());
console.log(`\nHiding groups of objects (layers): ${pass} passed, ${fail} failed`); process.exit(fail ? 1 : 0);
