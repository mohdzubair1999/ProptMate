import { readFileSync } from "node:fs";
import { getEmailSignatureHtml as H, getEmailSignatureText as T, resolveSignature as R, escapeHtml } from "../lib/emailSignature";
let pass = 0, fail = 0; const ok = (n: string, c: boolean, x: any = "") => { c ? pass++ : (fail++, console.log("FAIL:", n, typeof x === "string" ? x.slice(0, 300) : JSON.stringify(x).slice(0, 400))); };
for (const k of ["REPORT_SIGNATURE_NAME", "REPORT_SIGNATURE_COMPANY", "REPORT_SIGNATURE_EMAIL", "REPORT_SIGNATURE_WEBSITE"]) delete process.env[k];
const SENDER = { name: "Priya Shah", company: "Hatfield Lettings Ltd", email: "priya@hatfieldlettings.co.uk", website: "https://www.hatfieldlettings.co.uk/" };
// ---------- whose name is on it ----------
ok("the email is signed by whoever is SENDING: their name, their company, their email, their website (protocol and trailing slash tidied)", (() => { const s = R(SENDER); return s.name === "Priya Shah" && s.company === "Hatfield Lettings Ltd" && s.email === "priya@hatfieldlettings.co.uk" && s.website === "www.hatfieldlettings.co.uk"; })());
ok("another company's customer never sees the owner's details when the sender's are known", ![H(SENDER), T(SENDER)].some((x) => /Zubair|zkmholdings/i.test(x)));
ok("nothing given at all: the built-in defaults, exactly as the emails always read", (() => { const s = R(); return s.name === "Zubair Mohammed" && s.company === "ZKM Holdings Limited (ProptMate)" && s.email === "md@zkmholdingslimited.com" && s.website === "zkmholdingslimited.com" && R(null).name === s.name && R({}).company === s.company; })());
ok("the REPORT_SIGNATURE_* settings are used for anything the sender has not got (and the sender's own details still win)", (() => { process.env.REPORT_SIGNATURE_COMPANY = "Acme Homes"; process.env.REPORT_SIGNATURE_WEBSITE = "acme.example"; const a = R({ name: "Sam" }), b = R(SENDER); delete process.env.REPORT_SIGNATURE_COMPANY; delete process.env.REPORT_SIGNATURE_WEBSITE; return a.company === "Acme Homes" && a.website === "acme.example" && a.name === "Sam" && b.company === "Hatfield Lettings Ltd"; })());
ok("each missing detail falls back on its own: a name with no company gets the default company, a company with no name gets the default name", R({ name: "Sam" }).company === "ZKM Holdings Limited (ProptMate)" && R({ company: "Acme" }).name === "Zubair Mohammed");
ok("blank, spaces-only and non-text details count as missing", [{ name: "   " }, { name: "" }, { name: 5 as any }, { name: null }, { name: {} as any }].every((i) => R(i).name === "Zubair Mohammed"));
// ---------- bad details are dropped, never trusted ----------
ok("an email address that is not an address (spaces, markup, quotes, two @, no dot) is dropped for the fallback", ["not an email", "a@b", "<x>@y.com", 'a"b@c.com', "a@@b.com", "a b@c.com", "javascript:alert(1)", "a@b.com, c@d.com", "x@y.com\nBcc: z@z.com"].every((e) => R({ email: e }).email === "md@zkmholdingslimited.com"));
ok("a website that is not a plain web address (a script link, spaces, quotes, markup, no dot) is dropped for the fallback", ["javascript:alert(1)", "exa mple.com", 'evil.com"><script>', "localhost", "evil.com/<x>", "//evil", "data:text/html,x", "a.b c.d"].every((w) => R({ website: w }).website === "zkmholdingslimited.com"));
ok("real addresses are kept: example.com, www.example.co.uk, https://example.com/, example.com/about-us", [["example.com", "example.com"], ["www.example.co.uk", "www.example.co.uk"], ["https://example.com/", "example.com"], ["HTTP://example.com/about-us", "example.com/about-us"]].every(([i, o]) => R({ website: i }).website === o));
ok("line breaks and control characters in a name cannot add lines or headers: every detail stays on one line, and the plain-text version is always exactly five lines", (() => { const t = T({ name: "Priya\nBcc: evil@x.com\r\nSubject: hi", company: "A\u0000B\tC", email: "p@q.com" }); return t.split("\n").length === 5 && !/\r/.test(t) && !t.includes("\u0000"); })());
ok("long details are cut (80 for a name, 100 for a company)", R({ name: "x".repeat(500) }).name.length === 80 && R({ company: "y".repeat(500) }).company.length === 100);
// ---------- safe in HTML ----------
const HOSTILE = [`<script>alert(1)</script>`, `"><img src=x onerror=alert(1)>`, `' onmouseover='alert(1)`, `Tom & Jerry's <b>Lets</b>`, `</p><a href="https://evil">click</a>`, `&lt;already&gt;`];
const tags = (h: string) => (h.match(/</g) || []).length, baseTags = tags(H(SENDER));
ok("hostile names and company names can never add a tag or an attribute to the email: the HTML has exactly the same tags as with an ordinary name (the words themselves are shown as harmless text)", HOSTILE.every((x) => { const h = H({ ...SENDER, name: x, company: x }); return tags(h) === baseTags && !/<script|<img|<b>|<a href="https:\/\/evil/.test(h) && (h.match(/ on[a-z]+=/gi) || []).every((m) => !/<[^>]*$/.test(h.slice(0, h.indexOf(m)))); }), HOSTILE.map((x) => tags(H({ ...SENDER, name: x, company: x }))));
ok("special characters are shown correctly instead: an & and an apostrophe come out as &amp; and &#39;", /Tom &amp; Jerry&#39;s &lt;b&gt;Lets&lt;\/b&gt;/.test(H({ ...SENDER, name: HOSTILE[3] })) && escapeHtml(`<>&"'`) === "&lt;&gt;&amp;&quot;&#39;");
ok("the HTML and the plain-text versions say the same thing (same four details, same order)", (() => { const h = H(SENDER), t = T(SENDER); return [SENDER.name, SENDER.company, SENDER.email, "www.hatfieldlettings.co.uk"].every((v, i, a) => h.includes(v) && t.includes(v) && (i === 0 || t.indexOf(v) > t.indexOf(a[i - 1]))); })());
ok("the email address is a working mailto link and the website a working https link, in the HTML", /href="mailto:priya@hatfieldlettings\.co\.uk"/.test(H(SENDER)) && /href="https:\/\/www\.hatfieldlettings\.co\.uk"/.test(H(SENDER)));
ok("5,000 random hostile details: the HTML always has exactly the template's tags (no injected markup), whatever the input", (() => { let seed = 7, bad = 0; const r = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296; const chars = `<>"'&/\\ \n\r\t=;:()@.abcXYZ019%`; for (let i = 0; i < 5000; i++) { const rnd = () => Array.from({ length: Math.floor(r() * 40) }, () => chars[Math.floor(r() * chars.length)]).join(""); const h = H({ name: rnd(), company: rnd(), email: rnd(), website: rnd() }); if (tags(h) !== baseTags || /<(script|img|svg|iframe)/i.test(h)) bad++; const t = T({ name: rnd(), company: rnd(), email: rnd(), website: rnd() }); if (t.split("\n").length !== 5) bad++; } return bad === 0; })());
// ---------- all three senders use it ----------
const files = { report: readFileSync("app/api/email/send-report/route.ts", "utf8"), confirm: readFileSync("lib/actions/acknowledgements.ts", "utf8"), portal: readFileSync("lib/actions/portal.ts", "utf8") };
ok("the report email, the confirmation request and the portal invitation all look up who is sending and pass it to BOTH the HTML and the plain-text signature (none still uses the owner's fixed details)", Object.values(files).every((s) => /await getSignatureInfo\(companyId\)/.test(s) && /getEmailSignatureHtml\(signature\)/.test(s) && /getEmailSignatureText\(signature\)/.test(s) && !/getEmailSignature(Html|Text)\(\)/.test(s)), Object.entries(files).map(([k, s]) => [k, /getEmailSignatureHtml\(\)/.test(s)]));
ok("looking up the sender never throws (a missing session or company just means the settings are used), and only reads the sender's own company", /try \{[\s\S]*\} catch \{\s*return \{\};/.test(readFileSync("lib/emailSignatureInfo.ts", "utf8")) && /where: \{ id: companyId \}/.test(readFileSync("lib/emailSignatureInfo.ts", "utf8")));
console.log(`\nEmail signature (who it names, and that it is safe): ${pass} passed, ${fail} failed`); process.exit(fail ? 1 : 0);
