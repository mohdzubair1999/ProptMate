# Database (Postgres) — Supabase, Neon, Railway all work well with Vercel
DATABASE_URL="postgresql://user:password@host:5432/proptmate"
DIRECT_URL="postgresql://user:password@host:5432/proptmate"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (from Google Cloud Console) — optional, email/password works without it
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft (Outlook / Microsoft 365) — accepts both work/school accounts and personal
# Outlook.com/Hotmail accounts. Optional.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Apple Sign In — requires a paid Apple Developer Program membership ($99/year). Optional.
# Unlike the others, Apple's "secret" is a JWT you generate yourself — run:
#   node scripts/generate-apple-secret.js
# and paste the two values it prints below. Regenerate before it expires (~150 days).
APPLE_CLIENT_ID=""
APPLE_SECRET=""

# Photo storage — Vercel Blob
# Vercel dashboard -> Storage -> Create Database -> Blob -> copy token
# IMPORTANT: choose "Public" access when creating the store
BLOB_READ_WRITE_TOKEN=""

# AI features — polish, whole-report summary, and photo analysis
# Pick one or both. Anthropic (Claude) is used by default when both are set.
# OpenAI: platform.openai.com/api-keys
# Anthropic: console.anthropic.com/settings/keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Email — sending the final report to a landlord/tenant after generation
# Free account at resend.com, no domain verification needed to start
# (uses their shared onboarding@resend.dev sender until you verify your own domain)
RESEND_API_KEY=""
EMAIL_FROM=""
